<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>ot</AssemblyName>
		<RootNamespace>Overtime.Cli</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Published as one exe next to the app, so it doesn't clash with the app's own runtime files -->
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- Same database code as the app -->
		<Compile Include="..\data\OvertimeDbContext.cs" Link="data\OvertimeDbContext.cs" />
		<Compile Include="..\data\WorkedOvertime.cs" Link="data\WorkedOvertime.cs" />
		<Compile Include="..\data\OvertimeService..cs" Link="data\OvertimeService.cs" />
		<Compile Include="..\data\OvertimeStatistics.cs" Link="data\OvertimeStatistics.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
	</ItemGroup>

</Project>
