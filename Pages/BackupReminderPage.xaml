<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Overtime.BackupReminderPage"
             BackgroundColor="#80000000">

    <Border WidthRequest="420"
            Padding="24"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

        <VerticalStackLayout Spacing="16">
            <Label Text="No backup folder set" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />
            <Label Text="Your overtime is only stored on this computer. Set a backup folder, for example in OneDrive, so a copy is saved every time Overtime starts." />

            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="dontRemindCheckBox" VerticalOptions="Center" />
                <Label Text="Don't remind me again" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDontRemindLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                <Button Text="Not now" Clicked="OnNotNowClickedAsync" />
                <Button Text="Set up backup" Clicked="OnSetUpClickedAsync" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>

</ContentPage>
