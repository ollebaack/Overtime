<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Overtime.MainPage">

    <AbsoluteLayout>
        <!-- Other content -->
        <StackLayout Padding="20" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">

            <Entry Placeholder="Enter Hours" x:Name="hoursEntry" Keyboard="Numeric" Margin="0,0,0,20" Completed="OnEntryCompleted" />

            <Button x:Name="saveButton" Text="Add Overtime" Clicked="OnSaveClickedAsync" />

            <StackLayout>
                <Label
                    x:Name="totalTitleLabel"
                    Margin="10"
                    Style="{StaticResource Headline}" 
                    Text="Total Overtime" />
 
                <Label 
                    Margin="10"
                    Style="{StaticResource SubHeadline}"
                    Text="{Binding TotalSum, StringFormat='{0}'}"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand" />
            </StackLayout>

            <ListView x:Name="overtimeListView" HasUnevenRows="True" VerticalOptions="FillAndExpand">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0">
                                    <Label Text="{Binding Hours, StringFormat='Hours: {0}'}" />
                                    
                                    <Label Text="{Binding Date, StringFormat='Date: {0:d}'}" />
                                </StackLayout>

                                <StackLayout Grid.Column="1" HorizontalOptions="EndAndExpand">
                                    <Button Text="Delete" Clicked="OnDeleteClickedAsync" CommandParameter="{Binding .}" IsVisible="{Binding Deleted, Converter={StaticResource InvertedBooleanConverter}}" />
                                    <Button Text="Restore" Clicked="OnUndoDeleteClickedAsync" CommandParameter="{Binding .}" IsVisible="{Binding Deleted}" />
                                </StackLayout>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackLayout>

        <!-- Overlay Label -->
        <Label x:Name="successLabel"
               Text=""
               IsVisible="false"
               TextColor="Green"
               AbsoluteLayout.LayoutFlags="PositionProportional"
               AbsoluteLayout.LayoutBounds="1,1,-1,-1"
               BackgroundColor="Transparent"
               HorizontalOptions="End"
               VerticalOptions="End">
        </Label>
    </AbsoluteLayout>

</ContentPage>
