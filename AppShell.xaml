<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Overtime.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Overtime"
    Title="Overtime">

    <!-- Your Main Page -->
    <FlyoutItem Title="Overtime Tracker" Icon="icon_tab1.png">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <!-- Your New Page -->
    <FlyoutItem Title="New Page" Icon="icon_tab2.png">
        <ShellContent ContentTemplate="{DataTemplate local:MyNewPage}" />
    </FlyoutItem>

</Shell>
