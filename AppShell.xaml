<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Overtime.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Overtime"
    Title="Overtime">

    <!-- Your Main Page -->
    <FlyoutItem Title="Overtime Tracker" Icon="icon_tab1.png" Route="main">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Statistics" Route="stats">
        <ShellContent ContentTemplate="{DataTemplate local:StatisticsPage}" />
    </FlyoutItem>

    <!-- Your New Page -->
    <FlyoutItem Title="Backup" Icon="icon_tab2.png" Route="backup">
        <ShellContent ContentTemplate="{DataTemplate local:BackupPage}" />
    </FlyoutItem>

</Shell>
